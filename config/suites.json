{
  "version": 2,
  "default_target": "pto-isa",
  "targets": {
    "pto-isa": {
      "label": "pto-isa (CPU-ST + NPU-sim)",
      "repo_env": "PTO_ISA_REPO",
      "repo_default": "~/pto-isa",
      "repo_clone": "git@gitcode.com:ivanmang/pto-isa.git",
      "env_setup": "source \"$ASCEND_HOME_PATH/set_env.sh\" >/dev/null 2>&1 || true",
      "env": {},
      "testcase_dirs": {
        "cpu-st": "tests/cpu/st/testcase",
        "npu-sim-a3": "tests/npu/a2a3/src/st/testcase",
        "npu-hw-a3": "tests/npu/a2a3/src/st/testcase",
        "npu-sim-a5": "tests/npu/a5/src/st/testcase",
        "npu-hw-a5": "tests/npu/a5/src/st/testcase",
        "npu-sim-a6": "tests/npu/a6/src/st/testcase",
        "npu-hw-a6": "tests/npu/a6/src/st/testcase"
      },
      "suites": [
        {
          "name": "cpu-st",
          "mode": "cpu",
          "arch": null,
          "enabled": true,
          "milestone": "M1",
          "command": [
            "python3",
            "tests/run_cpu.py",
            "--clean",
            "--verbose"
          ],
          "timeout_s": 7200,
          "description": "CPU simulator ST \u2014 fast correctness tier (needs clang++>=15 or g++>=13)."
        },
        {
          "name": "npu-sim-a5",
          "mode": "npu-sim",
          "arch": "a5",
          "enabled": true,
          "milestone": "M1",
          "command": [
            "python3",
            "tests/script/run_st.py",
            "-r",
            "sim",
            "-v",
            "a5",
            "-t",
            "all"
          ],
          "timeout_s": 7200,
          "description": "NPU ST on the A5 simulator (Ascend950PR_9599 -> Ascend910_9599)."
        },
        {
          "name": "npu-sim-a3",
          "mode": "npu-sim",
          "arch": "a3",
          "enabled": true,
          "milestone": "M1",
          "command": [
            "python3",
            "tests/script/run_st.py",
            "-r",
            "sim",
            "-v",
            "a3",
            "-t",
            "all"
          ],
          "timeout_s": 7200,
          "description": "NPU ST on the A3 simulator (Ascend910B1)."
        },
        {
          "name": "npu-sim-a6",
          "mode": "npu-sim",
          "arch": "a6",
          "enabled": true,
          "milestone": "M1",
          "command": [
            "python3",
            "tests/script/run_st.py",
            "-r",
            "sim",
            "-v",
            "a6",
            "-t",
            "all"
          ],
          "timeout_s": 7200,
          "description": "NPU ST on the A6 simulator (dav_9201) \u2014 matches the A6/v200 workflow."
        },
        {
          "name": "npu-hw-a5",
          "mode": "npu",
          "arch": "a5",
          "enabled": false,
          "milestone": "M2",
          "command": [
            "python3",
            "tests/script/run_st.py",
            "-r",
            "npu",
            "-v",
            "a5",
            "-t",
            "all"
          ],
          "timeout_s": 7200,
          "description": "NPU ST on A5 hardware. Requires a device + ASCEND_HOME_PATH."
        },
        {
          "name": "costmodel-st",
          "mode": "costmodel",
          "arch": null,
          "enabled": false,
          "milestone": "M2",
          "command": [
            "./tests/run_costmodel_tests.sh"
          ],
          "timeout_s": 7200,
          "description": "Cost model ST (operator cost measurement)."
        },
        {
          "name": "comm-st",
          "mode": "comm",
          "arch": null,
          "enabled": false,
          "milestone": "M3",
          "command": [
            "./tests/run_comm_test.sh"
          ],
          "timeout_s": 7200,
          "description": "Communication ST (MPI + HCCL). Async tests need CANN 9.0+."
        },
        {
          "name": "static-gates",
          "mode": "static",
          "arch": null,
          "enabled": false,
          "milestone": "M2",
          "command": [
            "python3",
            "tests/validate_op_coverage.py"
          ],
          "timeout_s": 600,
          "description": "Operator coverage + testcase name validation (structural gates)."
        }
      ]
    },
    "pto-vmi": {
      "label": "pto-vmi (CCE + DSL)",
      "repo_env": "PTO_VMI_REPO",
      "repo_default": "~/pto-vmi",
      "repo_clone": "git@gitcode.com:csjlchen/pto-vmi.git",
      "env_setup": "source \"$ASCEND_HOME_PATH/set_env.sh\" >/dev/null 2>&1 || true\nexport PTO_VENV=\"${PTO_VENV:-$HOME/.venv-ptoas312}\"\nexport PATH=\"$PTO_VENV/bin:$PATH\"\nexport PYTHON_BIN=\"$PTO_VENV/bin/python3\"\nexport PTOAS_BIN=\"$PTO_VENV/bin/ptoas\"",
      "env": {},
      "testcase_dirs": {
        "dsl-st": "dsl",
        "cce-st": "cce",
        "tilelang-st": "tilelang"
      },
      "suites": [
        {
          "name": "dsl-st",
          "mode": "npu-sim",
          "arch": "a5",
          "runner": "generic",
          "testcase_kind": "file",
          "perf_copy": [
            "build/msprof_res/{testcase_stem}/OPPROF_*/dump"
          ],
          "enabled": true,
          "milestone": "M1",
          "command": [
            "bash",
            "scripts/sim_dsl.sh",
            "dsl/{testcase}"
          ],
          "timeout_s": 7200,
          "description": "DSL ST on the A5 simulator (ptoas-vmi msprof). Run one DSL case (.py)."
        },
        {
          "name": "cce-st",
          "mode": "npu-sim",
          "arch": "a5",
          "runner": "generic",
          "enabled": false,
          "milestone": "M2",
          "command": [
            "bash",
            "cce/{testcase}/run.sh",
            "-r",
            "sim",
            "-v",
            "{soc}"
          ],
          "timeout_s": 7200,
          "description": "CCE ST on the A5 simulator (bisheng + camodel). Run one CCE kernel's per-kernel run.sh (cce/<Kernel>/run.sh); the CA skill's run_cce_part1.sh orchestrates the full auto-discovered set.",
          "testcase_kind": "dir"
        },
        {
          "name": "tilelang-st",
          "mode": "npu-sim",
          "arch": "a5",
          "runner": "generic",
          "testcase_kind": "file",
          "perf_copy": [
            "build/msprof_res/{testcase_stem}/OPPROF_*/dump"
          ],
          "enabled": false,
          "milestone": "M3",
          "command": [
            "bash",
            "scripts/sim_dsl.sh",
            "tilelang/{testcase}"
          ],
          "timeout_s": 7200,
          "description": "TileLang kernels on the A5 simulator."
        }
      ]
    },
    "tilelangGym": {
      "label": "tilelangGym (SoftLib/ST + VMI Motif gate)",
      "repo_env": "SKILL_FOUNDRY_HOME",
      "repo_default": ".",
      "repo_clone": null,
      "env_setup": "export TILELANGGYM_PACK=\"${TILELANGGYM_PACK:-$PWD/demo/fixtures/tilelanggym-pack-ok}\"\nexport PYTHONPATH=\"$PWD${PYTHONPATH:+:$PYTHONPATH}\"",
      "env": {},
      "testcase_dirs": {
        "sv567-1xg-clean": "demo/fixtures/tilelanggym-pack-ok",
        "sv567-nx1-outer": "demo/fixtures/tilelanggym-pack-ok"
      },
      "suites": [
        {
          "name": "sv567-1xg-clean",
          "mode": "static",
          "arch": null,
          "runner": "generic",
          "enabled": true,
          "milestone": "M1",
          "command": [
            "bash",
            "scripts/tilelanggym_gate_suite.sh",
            "sv567-1xg-clean"
          ],
          "timeout_s": 600,
          "description": "Gate SoftLib 1xG Motif ladder + Done-bar + TRACE + PRC + PR9 both-arms against TILELANGGYM_PACK (no multi-hour opencode)."
        },
        {
          "name": "sv567-nx1-outer",
          "mode": "static",
          "arch": null,
          "runner": "generic",
          "enabled": true,
          "milestone": "M1",
          "command": [
            "bash",
            "scripts/tilelanggym_gate_suite.sh",
            "sv567-nx1-outer"
          ],
          "timeout_s": 600,
          "description": "Gate VMI outer Nx1 pure-VMAX dual-era + VAND alternate-builder Motif against TILELANGGYM_PACK."
        },
        {
          "name": "opencode-full",
          "mode": "static",
          "arch": null,
          "runner": "generic",
          "enabled": false,
          "milestone": "M3",
          "command": [
            "bash",
            "-c",
            "echo 'Full opencode SoftLib/ST launch stays custom (hours); use tip packs + tilelanggym-st-explore. Gate suites above are the foundry USE path.'; exit 2"
          ],
          "timeout_s": 60,
          "description": "Placeholder \u2014 full opencode clean regress (multi-hour) deliberately out of skill-foundry CI. Keep enabled:false."
        }
      ]
    }
  }
}
