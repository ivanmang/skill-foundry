#!/usr/bin/env bash
# skill-foundry — single entry point.
#   ./harness help        full usage
#   ./harness help <verb> per-verb help
# Dispatch (including the interactive "What next?" wrap) happens in-process in
# Python; this shim only locates the repo and puts it on PYTHONPATH.
set -euo pipefail

HARNESS="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export PYTHONPATH="$HARNESS${PYTHONPATH:+:$PYTHONPATH}"
exec python3 -m skill_foundry "$@"