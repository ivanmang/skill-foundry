#!/usr/bin/env bash
# regression-harness — single entry point.
#
#   ./harness run [--quiet] [--all-suites|--suite X] [--target T] [--testcase T] [--filter G] [--dry-run]
#   ./harness report [--run <id>/run.json] [--known <file>] [--out <base>] [--open]
#   ./harness review [--run <id>/run.json]
#   ./harness teach "symptom -> correct -> action" | (wizard) | --edit
#   ./harness promote --propose | --apply | --pr
#   ./harness baseline [--force] [target]
#   ./harness history [--limit N] [--json]
#   ./harness clean [--dry-run] [--keep N]
#   ./harness open [run-id]
#   ./harness validate
#   ./harness status | diagnose | onboarding | tui | menu
#   ./harness guide | demo | list | cann | selfcheck
#   ./harness help [verb] | version [--short]
#   ./harness (bare) -> interactive menu (help when piped)
set -euo pipefail

HARNESS="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

version() {
  local sha ver
  sha="$(git -C "$HARNESS" describe --tags --always 2>/dev/null || echo dev)"
  ver="$(cat "$HARNESS/VERSION" 2>/dev/null || echo 0.0.0)"
  if [[ "${1:-}" == "--short" ]]; then
    echo "$ver"
  else
    echo "regression-harness $ver ($sha)"
  fi
}

usage() {
  cat <<'EOF'
usage: ./harness <command> [args]

USE — run → report → review:
  run       Run a declared suite               [--suite | --all-suites] [--testcase] [--filter] [--quiet|--tui|--json] [--dry-run] [--parallel]
  report    Render a run to Markdown + HTML    [--run (default: latest), --known, --out, --open]
  review    Diff a run vs the pinned baseline  [--run (default: latest), --baseline, --out]

IMPROVE — teach → promote:
  teach     Log a correction                   ["wrong -> correct -> action" | wizard | --edit]
  promote   Propose or apply learnings         [--propose | --apply | --pr]

SKILLS — capture new skills:
  capture-skill  Draft a new skill in skills/inbox/  [--description, --dry-run]
  promote-skill  Promote a draft into .claude/skills/  [--propose | --apply | --pr]
  skills         List/search skills + refresh the catalog  [--search, --inbox, --refresh, --json]

SETUP:
  onboarding  Guided first-run setup
  status      One-glance dashboard             [--json, --target]
  diagnose    Check env + print exact fixes    [--json, --strict]
  targets     List configured targets          [--json]
  install-skills  Link skills into each agent's user dir  [--dry-run, --uninstall]
  cann        Which CANN supports which arch   [--home, --scan, --json]

INTERACTIVE:
  guide     Interactive step-by-step tour      [--demo]
  demo      Sandboxed walkthrough (interactive) [--straight]
  tui       Full-screen dashboard (interactive)
  menu      Curated interactive menu (bare ./harness default)

BASELINE & HOUSEKEEPING:
  baseline  Re-pin reports/baseline/<target>.json  [--force] [target]
  history   List recent runs                   [--limit N, --json]
  clean     Remove run dirs (keeps baseline)   [--dry-run, --keep N]
  open      Open a run's report.html           [run-id (default: latest)]
  validate  Check suites/arches/cann configs
  list      List suites + arches               [--target, --format text|markdown|html]
  selfcheck Compile-check + skill-spec validation + demo smoke

  help      Show this help — or: ./harness help <verb> for examples
  version   Show the harness version           [--short]

Examples:
  ./harness status
  ./harness run --all-suites --dry-run      # preview before the real run
  ./harness run --suite npu-sim-a5 --testcase tpartargmax
  ./harness report --open                  # latest run, in the browser
  ./harness review                         # latest run vs baseline
  ./harness teach "vcvt mismatch -> annotate as known -> add to known-failures"
  ./harness demo                           # no hardware needed
EOF
}

verb_help() {
  case "$1" in
    run) cat <<'EOF'
./harness run — run a declared suite
  --suite <name>   one suite (force-runs even if prereqs are missing)
  --all-suites     every enabled suite that is runnable here (auto-skips the rest)
  --target <t>     target key in config/suites.json (default pto-isa)
  --testcase <t>   one testcase (e.g. tpartargmax); --filter <g> a gtest filter
  --quiet          summary only   --tui live spinner   --json machine output
  --dry-run        print what WOULD run and exit (no run.json)
  --parallel       run independent suites concurrently (implies per-suite quiet)

Examples:
  ./harness run --all-suites --dry-run
  ./harness run --all-suites --quiet
  ./harness run --suite npu-sim-a5 --testcase tpartargmax
  ./harness run --suite cpu-st --testcase tadd --filter 'TADDTest.case_*'
EOF
    ;;
    report) cat <<'EOF'
./harness report — render run.json -> report.md/.html
  --run <path>   run.json (default latest run)
  --known <file> known-failures.md to annotate known failures
  --out <base>   output base path (default <run>/report)
  --open         open the HTML in the browser

Examples:
  ./harness report
  ./harness report --open
  ./harness report --run reports/<id>/run.json --known .claude/skills/pto-isa/references/known-failures.md
EOF
    ;;
    review) cat <<'EOF'
./harness review — diff a run vs the pinned baseline
  --run <path>      run.json (default latest run)
  --baseline <path> baseline.json (default: reports/baseline/<target>.json for the run's target)

Example: ./harness review
EOF
    ;;
    teach) cat <<'EOF'
./harness teach — log a correction (append-only)
  "wrong -> correct -> action"  one-line shorthand
  (no args)                     interactive wizard
  --edit                        open $EDITOR with a template

Example: ./harness teach "vcvt mismatch -> known pattern, annotate -> promote to known-failures"
EOF
    ;;
    promote) cat <<'EOF'
./harness promote — promote pending learnings into skills (merge is remote-gated)
  --propose   print a reviewable diff (no write)
  --apply     write the edits locally
  --pr        apply + branch + commit + push + AUTO-CREATE the MR (glab / GITCODE_TOKEN)

Example: ./harness promote --pr    # then merge the MR on the remote
EOF
    ;;
    capture-skill) cat <<'EOF'
./harness capture-skill <name> [--description "…"] [--dry-run]
Draft a NEW skill into skills/inbox/<name>/SKILL.md (wizard / editor for the body).
Example: ./harness capture-skill code-review --description "Review PRs against house style"
EOF
    ;;
    promote-skill) cat <<'EOF'
./harness promote-skill [<name>] [--propose | --apply | --pr]
Promote a draft from skills/inbox/ into .claude/skills/ (+ auto-MR with --pr).
Example: ./harness promote-skill code-review --pr
EOF
    ;;
    skills) cat <<'EOF'
./harness skills [--search <q>] [--inbox] [--refresh] [--json]
List/search skills (published .claude/skills/ + drafts skills/inbox/); --refresh
regenerates skills/catalog.json.
Examples: ./harness skills           ./harness skills --inbox
EOF
    ;;
    status) cat <<'EOF'
./harness status — one-glance dashboard (env, per-target suites, baseline, learnings, last run)
  --target <t>  show only one target
  --json        machine output
Example: ./harness status
EOF
    ;;
    targets) cat <<'EOF'
./harness targets — list configured targets (name, label, repo, suites)
  --json  machine output
Examples: ./harness targets           ./harness targets --json
EOF
    ;;
    install-skills) cat <<'EOF'
./harness install-skills — make the harness skills discoverable by each installed agent
  --dry-run    show what would be linked
  --uninstall  remove the harness skill symlinks
Project-level discovery works via .claude/skills/ + .agents/skills/; this links
into user dirs (Claude Code ~/.claude/skills, Pi ~/.pi/skills, open ~/.agents/skills).
Example: ./harness install-skills
EOF
    ;;
    diagnose) cat <<'EOF'
./harness diagnose — check this machine and print the exact fix for each issue
  --json    machine output
  --strict  exit 1 if any issue (for CI)
Example: ./harness diagnose
EOF
    ;;
    demo) cat <<'EOF'
./harness demo — interactive sandboxed walkthrough (no hardware)
  --straight  run straight through (CI / presenting)
Example: ./harness demo
EOF
    ;;
    guide) cat <<'EOF'
./harness guide — interactive tour of the real pto-isa flow (env -> choose -> run -> report -> review -> teach -> promote)
  --demo  jump straight to the sandboxed demo
Example: ./harness guide
EOF
    ;;
    baseline) cat <<'EOF'
./harness baseline [--force] <target> — run all enabled (runnable) suites and re-pin reports/baseline/<target>.json
Refuses unless every suite PASSes (use --force to override).
Example: ./harness baseline pto-isa
EOF
    ;;
    list) cat <<'EOF'
./harness list — list suites + arches with auto-detected availability
  --target <t>  --format text|markdown|html
Example: ./harness list
EOF
    ;;
    cann) cat <<'EOF'
./harness cann — which installed CANN supports which arch (headers vs simulator)
  --home <path>  --scan  --json
Example: ./harness cann
EOF
    ;;
    onboarding) cat <<'EOF'
./harness onboarding — guided first-run setup (detect env, write env.sh, pick CANN, verify pto-isa)
Example: ./harness onboarding
EOF
    ;;
    tui) cat <<'EOF'
./harness tui — full-screen dashboard (status + action menu)
Example: ./harness tui
EOF
    ;;
    *) echo "no detailed help for '$1' — run ./harness help" ;;
  esac
}

CMD="${1:-menu}"
shift || true

# In an interactive terminal, wrap non-UI verbs so the user gets a guided
# "What next?" arrow menu after each one (unless HARNESS_WRAPPED is already set
# by an outer wrap/menu/tui loop, or the verb is itself a menu/terminal).
if [[ -t 0 && -t 1 && -z "${HARNESS_WRAPPED:-}" ]]; then
  case "$CMD" in
    menu|tui|help|-h|--help|version|--version|-V|__complete|selfcheck) ;;
    *)
      export HARNESS_WRAPPED=1
      exec python3 "$HARNESS/scripts/wrap.py" "$CMD" "$@"
      ;;
  esac
fi

case "$CMD" in
  run)      exec python3 "$HARNESS/scripts/run_suite.py" "$@" ;;
  report)   exec python3 "$HARNESS/scripts/build_report.py" "$@" ;;
  review)   exec python3 "$HARNESS/scripts/diff_runs.py" "$@" ;;
  teach)    exec "$HARNESS/scripts/teach" "$@" ;;
  promote)  exec python3 "$HARNESS/scripts/promote_recent.py" "$@" ;;
  capture-skill) exec python3 "$HARNESS/scripts/capture_skill.py" "$@" ;;
  promote-skill) exec python3 "$HARNESS/scripts/promote_skill.py" "$@" ;;
  skills)   exec python3 "$HARNESS/scripts/skills_cli.py" "$@" ;;
  baseline) exec "$HARNESS/scripts/make_baseline.sh" "$@" ;;
  history)  exec python3 "$HARNESS/scripts/history.py" "$@" ;;
  clean)    exec python3 "$HARNESS/scripts/clean.py" "$@" ;;
  open)     exec python3 "$HARNESS/scripts/open_report.py" "$@" ;;
  validate) exec python3 "$HARNESS/scripts/validate.py" "$@" ;;
  status)   exec python3 "$HARNESS/scripts/status.py" "$@" ;;
  diagnose) exec python3 "$HARNESS/scripts/diagnose.py" "$@" ;;
  targets)  exec python3 "$HARNESS/scripts/targets_cli.py" "$@" ;;
  install-skills) exec python3 "$HARNESS/scripts/install_skills.py" "$@" ;;
  onboarding) exec python3 "$HARNESS/scripts/onboarding.py" "$@" ;;
  tui)      exec python3 "$HARNESS/scripts/tui.py" "$@" ;;
  menu)     exec python3 "$HARNESS/scripts/menu.py" "$@" ;;
  guide)    exec python3 "$HARNESS/scripts/guide.py" "$@" ;;
  demo)     exec python3 "$HARNESS/scripts/demo_tour.py" "$@" ;;
  list)     exec python3 "$HARNESS/scripts/run_suite.py" --list "$@" ;;
  cann)     exec python3 "$HARNESS/scripts/detect_cann.py" "$@" ;;
  selfcheck) exec "$HARNESS/scripts/selfcheck" ;;
  __complete) exec python3 "$HARNESS/scripts/complete.py" "$@" ;;
  help|-h|--help)
    if [[ -n "${1:-}" && "$1" != "-h" && "$1" != "--help" ]]; then
      verb_help "$1"
    else
      usage
    fi
    ;;
  version|--version|-V) version "$@" ;;
  *) echo "unknown command: $CMD" >&2; usage >&2; exit 2 ;;
esac